{
  "extends": "@motion-canvas/2d/tsconfig.project.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "music",
    "scripts",
    "vite.config.ts"
  ]
}
