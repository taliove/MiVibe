{
  "name": "mivibe-promo",
  "version": "1.0.0",
  "description": "MiVibe 宣传片：Motion Canvas 画面 + 程序合成配乐",
  "scripts": {
    "dev": "vite",
    "music": "node music/generate.ts",
    "frames": "node scripts/render.ts",
    "encode": "node scripts/encode.ts",
    "check": "node scripts/check.ts",
    "build": "pnpm music && pnpm frames && pnpm encode",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/ffmpeg": "3.17.2",
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@types/node": "^26.6.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.33.0"
}
